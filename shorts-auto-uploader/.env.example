# Which platforms to publish to (comma-separated): youtube,instagram,tiktok
PLATFORMS=youtube

# --- YouTube (YouTube Data API v3) ---
# OAuth client created in Google Cloud Console -> download client_secret.json
YOUTUBE_CLIENT_SECRET_FILE=config/youtube_client_secret.json
# Created on first run via oauth_bootstrap.py, then reused by CI as a secret
YOUTUBE_TOKEN_FILE=config/youtube_token.json

# --- Instagram (Meta Graph API, Reels) ---
# Instagram professional account connected to a Facebook Page
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=
# Reels publishing requires the source video at a public HTTPS URL.
# This project uploads the rendered file to the host below before calling the Graph API.
PUBLIC_VIDEO_HOST_UPLOAD_URL=

# --- TikTok (Content Posting API) ---
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=
